{
  "panelFamily": "ii",
  "dock": {
    "enable": true,
    "height": 60,
    "hoverRegionHeight": 2,
    "hoverToReveal": true,
    "ignoredAppRegexes": [],
    "monochromeIcons": true,
    "pinnedApps": [
      "helium",
      "brave-origin",
      "herdr-app",
      "dev.zed.Zed",
      "com.vscodium.codium",
      "org.telegram.desktop",
      "com.discordapp.Discord",
      "kitty",
      "org.gnome.Nautilus"
    ],
    "pinnedOnStartup": false
  },
  "language": {
    "ui": "en_US"
  },
  "policies": {
    "ai": 0,
    "weeb": 0
  },
  "bar": {
    "cornerStyle": 2
  },
  "appearance": {
    "fakeScreenRounding": 0,
    "wallpaperTheming": {
      "enableAppsAndShell": true,
      "enableQtApps": true,
      "enableTerminal": true
    }
  },
  "background": {
    "widgets": {
      "clock": {
        "cookie": {
          "aiStyling": false
        }
      }
    },
    "parallax": {
      "enableWorkspace": false,
      "enableSidebar": false
    }
  },
  "updates": {
    "enableCheck": false
  },
  "light": {
    "antiFlashbang": {
      "enable": false
    }
  },
  "windows": {
    "centerTitle": true,
    "dragCornerPercent": 30,
    "dragCornerSnap": true,
    "floatingByDefault": true,
    "showTitlebar": true
  }
}
